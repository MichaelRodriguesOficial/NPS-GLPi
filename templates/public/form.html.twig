<div class="npsphere-public-page">
    <div class="npsphere-public-card">
        <h1>{{ survey.fields['name'] }}</h1>
        {% if survey.fields['description'] %}
            <p class="npsphere-public-intro">{{ survey.fields['description'] }}</p>
        {% endif %}

        {# Opção clicada no e-mail: o script abaixo grava e mostra aqui. #}
        <div class="npsphere-um-clique" role="status" aria-live="polite" hidden></div>

        {% if ja_respondeu|default(false) and not um_clique|default(null) %}
            <div class="alert alert-info">
                <i class="ti ti-info-circle"></i>
                {{ __('Você já respondeu esta pesquisa. Se quiser, altere as respostas abaixo e envie de novo.', 'npsphere') }}
            </div>
        {% endif %}

        {% if errors is not empty %}
            <div class="alert alert-danger">
                <ul class="mb-0">
                    {% for error in errors %}<li>{{ error }}</li>{% endfor %}
                </ul>
            </div>
        {% endif %}

        <form method="post" action="" class="npsphere-question-steps"
              data-display-mode="{{ survey.fields['display_mode'] }}"
              data-identity-check-url="{{ identity_check_url|default('') }}"
              data-token-url="{{ token_url|default('') }}"
              data-survey-token="{{ token }}"
              {% if um_clique|default(null) %}data-um-clique="{{ um_clique|json_encode|e('html_attr') }}"{% endif %}>
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="token" value="{{ token }}">
            <input type="hidden" name="surveys_id" value="{{ survey.getID() }}">
            <input type="hidden" name="_started_at" value="{{ started_at }}">
            {% if convite|default('') %}
                <input type="hidden" name="convite" value="{{ convite }}">
            {% endif %}

            {% if requires_identity %}
                {# Marcado como .npsphere-step para virar a PRIMEIRA etapa
                   quando o formato é "uma pergunta por etapa". O
                   data-require-all diz ao validador que aqui TODOS os
                   campos são obrigatórios (numa pergunta comum basta um
                   valor preenchido; aqui são nome, e-mail E telefone). #}
                <fieldset class="npsphere-identity npsphere-step"
                          data-required="1" data-require-all="1">
                    <legend>{{ __('Seus dados', 'npsphere') }}</legend>
                    <p class="npsphere-identity-hint">
                        {{ __('Precisamos destes dados para identificar sua resposta. Todos são obrigatórios.', 'npsphere') }}
                    </p>

                    <div class="npsphere-identity-grid">
                        <div class="npsphere-field">
                            <label for="npsphere-name">{{ __('Nome', 'npsphere') }} <span class="text-danger">*</span></label>
                            <input type="text" id="npsphere-name" name="respondent_name" class="form-control"
                                   value="{{ identity['respondent_name']|default('') }}" required maxlength="255">
                        </div>

                        <div class="npsphere-field">
                            <label for="npsphere-email">{{ __('E-mail', 'npsphere') }} <span class="text-danger">*</span></label>
                            <input type="email" id="npsphere-email" name="respondent_email" class="form-control"
                                   value="{{ identity['respondent_email']|default('') }}" required maxlength="255"
                                   autocomplete="email">
                            <small id="npsphere-email-help"></small>
                        </div>

                        <div class="npsphere-field npsphere-field-wide">
                            <label for="npsphere-phone">{{ __('Telefone', 'npsphere') }} <span class="text-danger">*</span></label>
                            <div class="npsphere-phone-group">
                                <select name="respondent_phone_country" id="npsphere-phone-country" class="form-select npsphere-phone-country">
                                    {% for c in countries %}
                                        <option value="{{ c.iso }}"
                                                data-dial="{{ c.dial }}"
                                                data-lengths="{{ c.lengths|join(',') }}"
                                                {{ (identity['respondent_phone_country']|default('BR')) == c.iso ? 'selected' : '' }}>
                                            {{ c.flag }} +{{ c.dial }} {{ c.label }}
                                        </option>
                                    {% endfor %}
                                </select>
                                <input type="tel" id="npsphere-phone" name="respondent_phone" class="form-control"
                                       value="{{ identity['respondent_phone']|default('') }}" required
                                       inputmode="numeric" autocomplete="tel">
                            </div>
                            <small id="npsphere-phone-help"></small>
                        </div>
                    </div>
                </fieldset>
            {% endif %}

            {% for item in fields %}
                <div class="npsphere-question-block npsphere-step mb-4"
                     data-required="{{ item.question['is_required'] ? '1' : '0' }}"
                     data-question-id="{{ item.question['id'] }}"
                     data-cond-trigger="{{ item.question['condition_questions_id']|default(0) }}"
                     data-cond-operator="{{ item.question['condition_operator']|default('') }}"
                     data-cond-value="{{ item.question['condition_value']|default('') }}">
                    <label class="npsphere-question-label">
                        {{ item.question['name'] }}
                        {% if item.question['is_required'] %}<span class="text-danger">*</span>{% endif %}
                    </label>
                    {% if item.question['description'] %}
                        <p class="text-muted small">{{ item.question['description'] }}</p>
                    {% endif %}
                    <div class="npsphere-question-field">{{ item.field_html|raw }}</div>
                </div>
            {% endfor %}

            <div class="d-flex justify-content-end">
                <button type="submit" name="submit_answer" value="1" class="btn btn-primary npsphere-submit-btn">
                    <i class="ti ti-send"></i>
                    <span>{{ __('Enviar avaliação', 'npsphere') }}</span>
                </button>
            </div>
        </form>
    </div>

    {% if survey.fields['is_anonymous'] %}
        <p class="npsphere-public-foot">
            <i class="ti ti-lock"></i>
            {{ __('Esta pesquisa é anônima: sua identidade não é registrada.', 'npsphere') }}
        </p>
    {% endif %}
</div>

<script>
(function () {
    var country = document.getElementById('npsphere-phone-country');
    var phone = document.getElementById('npsphere-phone');
    var help = document.getElementById('npsphere-phone-help');
    if (!country || !phone) {
        return;
    }

    function selected() {
        return country.options[country.selectedIndex];
    }

    function expectedLengths() {
        return (selected().dataset.lengths || '').split(',').map(Number);
    }

    // Se a pessoa colar/digitar o número já com o código internacional
    // (+351..., 00351...), troca o país sozinho em vez de reclamar que
    // o número tem dígitos demais.
    function detectCountryFromInput(digits) {
        if (!/^(\+|00)/.test(phone.value.trim())) {
            return digits;
        }
        var normalized = digits.replace(/^00/, '');
        var options = Array.prototype.slice.call(country.options);
        // Códigos mais longos primeiro (351 antes de 1, 55 antes de 5).
        options.sort(function (a, b) {
            return (b.dataset.dial || '').length - (a.dataset.dial || '').length;
        });
        for (var i = 0; i < options.length; i++) {
            var dial = options[i].dataset.dial;
            if (dial && normalized.indexOf(dial) === 0) {
                country.value = options[i].value;
                return normalized.slice(dial.length);
            }
        }
        return normalized;
    }

    // Máscara simples para o Brasil, onde o formato é bem conhecido.
    function formatBR(d) {
        if (d.length <= 2) { return d; }
        if (d.length <= 6) { return '(' + d.slice(0, 2) + ') ' + d.slice(2); }
        if (d.length <= 10) { return '(' + d.slice(0, 2) + ') ' + d.slice(2, 6) + '-' + d.slice(6); }
        return '(' + d.slice(0, 2) + ') ' + d.slice(2, 7) + '-' + d.slice(7, 11);
    }

    function render() {
        var digits = phone.value.replace(/\D+/g, '');
        digits = detectCountryFromInput(digits);

        var lengths = expectedLengths();
        var max = Math.max.apply(null, lengths);
        digits = digits.slice(0, max);

        phone.value = (country.value === 'BR') ? formatBR(digits) : digits;

        if (help) {
            var ok = lengths.indexOf(digits.length) !== -1;
            help.textContent = digits.length === 0
                ? ''
                : (ok ? '' : {{ __('Este país usa %s dígitos.', 'npsphere')|json_encode|raw }}.replace('%s', lengths.join({{ __(' ou ', 'npsphere')|json_encode|raw }})));
            help.className = ok ? '' : 'npsphere-phone-warn';
        }
    }

    // Aviso imediato de e-mail inválido: sem isso a pessoa só
    // descobriria o erro ao tentar avançar.
    var email = document.getElementById('npsphere-email');
    var emailHelp = document.getElementById('npsphere-email-help');
    if (email && emailHelp) {
        var checkEmail = function () {
            var v = email.value.trim();
            var domain = v.slice(v.lastIndexOf('@') + 1);
            var tld = domain.slice(domain.lastIndexOf('.') + 1);
            var ok = /^[^\s@]+@[^\s@]+$/.test(v)
                && domain.indexOf('.') !== -1
                && domain.indexOf('..') === -1
                && domain[0] !== '.'
                && domain[domain.length - 1] !== '.'
                && /^[a-zA-Z]{2,}$/.test(tld);

            if (v === '') {
                emailHelp.textContent = '';
                emailHelp.className = '';
                return;
            }
            emailHelp.textContent = ok ? '' : {{ __('Informe um e-mail completo, como nome@empresa.com.br', 'npsphere')|json_encode|raw }};
            emailHelp.className = ok ? '' : 'npsphere-phone-warn';
        };
        email.addEventListener('blur', checkEmail);
        email.addEventListener('input', function () {
            if (emailHelp.textContent !== '') {
                checkEmail(); // corrige o aviso enquanto a pessoa digita
            }
        });
    }

    phone.addEventListener('input', render);
    country.addEventListener('change', function () { render(); phone.focus(); });
    render();
})();
</script>

<script>
(function () {
    var form = document.querySelector('.npsphere-public-page form');
    if (!form || !form.dataset.tokenUrl) {
        return;
    }

    // Busca um token CSRF NOVO imediatamente antes de enviar. O token
    // embutido no HTML pode ter expirado enquanto a pessoa preenchia a
    // pesquisa (o que causava "A ação que você requisitou não é
    // permitida" ao salvar) -- e numa pesquisa longa isso é justamente
    // o caso mais provável.
    var submitting = false;

    form.addEventListener('submit', function (event) {
        if (submitting) {
            return; // segunda passagem: deixa seguir de verdade
        }
        event.preventDefault();

        var url = form.dataset.tokenUrl + '?token=' +
                  encodeURIComponent(form.dataset.surveyToken);

        fetch(url, { method: 'GET' })
            .then(function (r) { return r.ok ? r.text() : null; })
            .then(function (token) {
                if (token && token.trim() !== '') {
                    var field = form.querySelector('input[name="_glpi_csrf_token"]');
                    if (field) {
                        field.value = token.trim();
                    }
                }
            })
            .catch(function () { /* segue com o token atual */ })
            .then(function () {
                submitting = true;
                // requestSubmit preserva o botão de envio clicado
                // (submit_answer), que o form.submit() descartaria.
                if (form.requestSubmit) {
                    var btn = form.querySelector('.npsphere-submit-btn');
                    form.requestSubmit(btn || undefined);
                } else {
                    form.submit();
                }
            });
    });
})();
</script>

<script>
(function () {
    // Opção clicada no e-mail (convite pessoal): grava sem a pessoa
    // precisar clicar em "Enviar".
    //
    // É ESTE script, rodando no navegador de quem clicou, que grava. A
    // página em si (o GET do link) não grava nada: filtros de segurança
    // de e-mail abrem os links para verificá-los, mas não fazem este POST.
    var form = document.querySelector('.npsphere-public-page form[data-um-clique]');
    if (!form || !window.fetch) {
        return;
    }

    var dados;
    try { dados = JSON.parse(form.dataset.umClique || 'null'); } catch (e) { dados = null; }
    if (!dados || !dados.url) {
        return;
    }

    var card  = form.closest('.npsphere-public-card');
    var aviso = card ? card.querySelector('.npsphere-um-clique') : null;

    function mostrar(classe, html) {
        if (!aviso) { return; }
        // A confirmação final não usa .alert: no tema do GLPI o .alert é
        // flex em linha, e ícone, título e textos ficavam lado a lado.
        aviso.className = 'npsphere-um-clique ' + (classe === 'npsphere-um-clique-ok' ? classe : 'alert ' + classe);
        // Nos avisos (.alert, que é flex), o texto vai num bloco só ao lado
        // do ícone: solto, cada trecho virava uma coluna (v0.64.2).
        if (classe !== 'npsphere-um-clique-ok') {
            html = html.replace(/^\s*(<i[^>]*><\/i>)?\s*/, function (m, icone) {
                return (icone || '') + '<div class="npsphere-um-clique-texto">';
            }) + '</div>';
        }
        aviso.innerHTML = html;
        aviso.hidden = false;
    }

    function texto(t) {
        var d = document.createElement('div');
        d.textContent = t == null ? '' : String(t);
        return d.innerHTML;
    }

    mostrar('alert-secondary', '<i class="ti ti-loader-2"></i> ' + {{ __('Registrando sua resposta…', 'npsphere')|json_encode|raw }});

    var urlToken = form.dataset.tokenUrl + '?token=' + encodeURIComponent(form.dataset.surveyToken);

    fetch(urlToken, { method: 'GET', credentials: 'same-origin' })
        .then(function (r) { return r.ok ? r.text() : ''; })
        .catch(function () { return ''; })
        .then(function (csrf) {
            csrf = (csrf || '').trim();
            var corpo = new FormData();
            corpo.append('token', form.dataset.surveyToken);
            corpo.append('convite', (form.querySelector('input[name="convite"]') || {}).value || '');
            corpo.append('pergunta', dados.pergunta);
            corpo.append('valor', dados.valor);
            var cabecalhos = { 'X-Requested-With': 'XMLHttpRequest' };
            if (csrf) {
                corpo.append('_glpi_csrf_token', csrf);
                cabecalhos['X-Glpi-Csrf-Token'] = csrf;
                var campo = form.querySelector('input[name="_glpi_csrf_token"]');
                if (campo) { campo.value = csrf; }
            }
            return fetch(dados.url, {
                method: 'POST',
                body: corpo,
                headers: cabecalhos,
                credentials: 'same-origin'
            });
        })
        .then(function (r) { return r.json(); })
        .then(function (res) {
            if (!res || !res.success) {
                // Não gravou: o formulário continua ali, com a opção já
                // marcada, e a pessoa envia do jeito normal.
                mostrar('alert-warning',
                    '<i class="ti ti-alert-triangle"></i> ' + {{ __('Não conseguimos registrar sua resposta automaticamente. Confira abaixo e clique em <strong>Enviar avaliação</strong>.', 'npsphere')|json_encode|raw }});
                return;
            }

            if (res.unica) {
                // Pesquisa de uma pergunta: está respondida. Troca o
                // formulário pela confirmação.
                form.style.display = 'none';
                var intro = card.querySelector('.npsphere-public-intro');
                if (intro) { intro.hidden = true; }
                // A confirmação ocupa o cartão inteiro: o título da pesquisa
                // sai de cima e entra pequeno dentro dela.
                var titulo = card.querySelector('h1');
                var NOME = titulo ? (titulo.querySelector('h3') || titulo).textContent.trim() : '';
                if (titulo) { titulo.style.display = 'none'; }
                mostrar('npsphere-um-clique-ok',
                    '<div class="npsphere-obrigado">'
                    + '<span class="npsphere-obrigado-pesquisa">' + texto(NOME) + '</span>'
                    + '<div class="npsphere-obrigado-icone"><i class="ti ti-check"></i></div>'
                    + '<h2>' + {{ __('Obrigado pela sua avaliação!', 'npsphere')|json_encode|raw }} + '</h2>'
                    + '<p class="npsphere-obrigado-sub">' + {{ __('Sua resposta foi registrada.', 'npsphere')|json_encode|raw }} + '</p>'
                    + '<div class="npsphere-obrigado-resposta">'
                    +   '<span class="npsphere-obrigado-pergunta">' + texto(res.pergunta || {{ __('Sua resposta', 'npsphere')|json_encode|raw }}) + '</span>'
                    +   '<span class="npsphere-obrigado-valor">' + texto(res.rotulo) + '</span>'
                    + '</div>'
                    + '<p class="npsphere-obrigado-dica"><i class="ti ti-refresh"></i> '
                    + {{ __('Mudou de ideia? É só clicar em outra opção no e-mail.', 'npsphere')|json_encode|raw }} + '</p>'
                    + '</div>');
                return;
            }

            mostrar('alert-success',
                '<i class="ti ti-circle-check"></i> ' + {{ __('Sua resposta para <strong>%1$s</strong> foi registrada: <strong>%2$s</strong>.', 'npsphere')|json_encode|raw }}
                    .replace('%1$s', function () { return texto(res.pergunta); })
                    .replace('%2$s', function () { return texto(res.rotulo); })
                + ' ' + {{ __('Responda as demais perguntas e clique em <strong>Enviar avaliação</strong> para concluir.', 'npsphere')|json_encode|raw }});
        })
        .catch(function () {
            mostrar('alert-warning',
                '<i class="ti ti-alert-triangle"></i> ' + {{ __('Não conseguimos registrar sua resposta automaticamente. Confira abaixo e clique em <strong>Enviar avaliação</strong>.', 'npsphere')|json_encode|raw }});
        });
})();
</script>
